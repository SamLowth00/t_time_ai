# t-time-ai frontend — environment variables
#
# Local dev: copy this file to `.env` (gitignored) and fill in real values.
#   cp .env.example .env
# Production: set these on the Railway frontend service ("Variables" tab).
# Never commit `.env`. This `.env.example` is the contract; `.env` has the secrets.


# Base URL of the Python backend.
# Local: the uvicorn dev server. Production: the deployed backend URL.
VITE_API_URL=http://127.0.0.1:8000
