# t-time-ai backend — environment variables
#
# Local dev: copy this file to `.env` (gitignored) and fill in real values.
#   cp .env.example .env
# Production: set these on the Railway backend service ("Variables" tab).
# Never commit `.env`. This `.env.example` is the contract; `.env` has the secrets.


# --- Required ---------------------------------------------------------------

# Google Places API key. Required in every environment.
# In GCP Console, restrict this key to "Places API (New)" only under
# Credentials → your key → "API restrictions" → "Restrict key". Limits blast
# radius if it ever leaks.
GOOGLE_API_KEY=


# --- Required in production, optional locally -------------------------------

# Redis URL for the rate-limit counters.
# Local: leave unset → falls back to in-memory storage (counters reset on
#   uvicorn restart; fine for solo dev).
# Production: set to Railway's managed Redis service's internal URL.
# REDIS_URL=redis://localhost:6379

# Frontend origin allowed by CORS (added on top of the dev origins, which are
# always allowed). Set this to the deployed frontend's URL in production.
# FRONTEND_ORIGIN=https://t-time-ai-frontend.up.railway.app


# --- Dev escape hatch (NEVER set in production) -----------------------------

# Bypass rate limiting entirely while iterating locally. Default is enabled.
# Any value other than the literal "false" leaves limiting on, so prod can't
# accidentally disable it by omitting the var.
# RATE_LIMIT_ENABLED=false
